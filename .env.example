# Server Configuration
PORT=5001
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here_change_in_production

# Database (Default: SQLite for instant zero-config testing)
# To use PostgreSQL / Supabase: postgresql://postgres:password@localhost:5432/paypilot
DATABASE_URL="file:./dev.db"

# PayPal Developer Sandbox (https://developer.paypal.com/dashboard/applications/sandbox)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here

# AI Service Configuration (Optional: PayPilot includes a built-in smart NLP financial engine)
# Add your Gemini or OpenAI API Key for advanced generative reasoning:
GEMINI_API_KEY=
OPENAI_API_KEY=
